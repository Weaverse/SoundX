{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!out",
      "!build",
      "!public",
      "!.weaverse",
      "!.agents",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "markdown": {
    "formatter": { "enabled": false }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@weaverse/next": "Import from @weaverse/hydrogen/next.",
              "@weaverse/next/server": "Import from @weaverse/hydrogen/next/server.",
              "@weaverse/hydrogen/react-router": "Use the Next.js adapter: @weaverse/hydrogen/next.",
              "@weaverse/core": "Import from @weaverse/hydrogen/next.",
              "@weaverse/react": "Import from @weaverse/hydrogen/next.",
              "@weaverse/schema": "Import from @weaverse/hydrogen/next."
            }
          }
        }
      }
    }
  }
}
